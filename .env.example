# Local Clinical Context Workbench literature-scout configuration.
# Copy this file to .env.local (ignored by Git) and add the developer contact
# address registered or used with the metadata providers.
CLINICAL_SCOUT_CONTACT_EMAIL=

# Optional. Without a key the scout stays below NCBI's lower public rate limit.
NCBI_API_KEY=

# Set to "false" to disable due-gap checks while the local workbench is open.
CLINICAL_SCOUT_AUTO=true

# Stable local audit identity for manual review actions. These values never
# come from browser commands. Use a distinct ID for each human reviewer.
CLINICAL_WORKBENCH_REVIEWER_ID=reviewer.local.owner
CLINICAL_WORKBENCH_REVIEWER_ROLE=owner

# Optional hosted private-pilot player authentication. When both are omitted,
# the static/local prototype exposes its explicit browser-local bypass and
# never asks for or stores a password.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set true only for a developer/static demonstration that intentionally keeps
# the local bypass even while hosted authentication is configured.
VITE_ENABLE_LOCAL_PROTOTYPE_BYPASS=false
