+function readClinicVisit(value: unknown, operation: Record<string, unknown>): ClinicVisitState | undefined {
+  if (value === undefined) return undefined;
+  const incomeByKind = {
+    adult_appointment: "income.app_consult", pediatric_consult: "income.pediatric_consult",
+    wound_care: "income.wound_care", ostomy_support: "income.ostomy_support", mri: "income.mri",
+  } as const;
+  if (!hasContractKeys(value, ["version", "kind", "demographics", "pediatricFamilyId", "requestedRoomInstanceId"]) ||
+      value.version !== "clinic-visit.v1" || typeof value.kind !== "string" || !(value.kind in incomeByKind) ||
+      operation.incomeLineId !== incomeByKind[value.kind as keyof typeof incomeByKind] || operation.actorKind !== "visitor" ||
+      !isPixelAppearance(operation.appearance) ||
+      !hasContractKeys(value.demographics, ["ageYears", "sexLabel"]) ||
+      typeof value.demographics.ageYears !== "number" || !Number.isSafeInteger(value.demographics.ageYears) ||
+      (value.demographics.sexLabel !== "Female" && value.demographics.sexLabel !== "Male")) {
+    throw new Error("The saved clinic visit is invalid.");
+  }
+  const pediatric = value.kind === "pediatric_consult";
+  const age = value.demographics.ageYears;
+  const familyId = readPediatricFamilyId(value.pediatricFamilyId);
+  if (age < (pediatric ? 5 : 18) || age > (pediatric ? 17 : 120) || pediatric !== Boolean(familyId)) {
+    throw new Error("The saved clinic visit has invalid patient eligibility or family linkage.");
+  }
+  if (pediatric && !pediatricStillEligibleEntries(value.demographics.sexLabel, age).some(still => still.stillId === (operation.appearance as { stillId?: string }).stillId)) {
+    throw new Error("The saved pediatric appearance must match the frozen age and sex.");
+  }
+  if (value.requestedRoomInstanceId !== undefined &&
+    (!["adult_appointment", "pediatric_consult", "wound_care", "ostomy_support"].includes(value.kind) || !isSpecialtyId(value.requestedRoomInstanceId))) {
+    throw new Error("The saved clinic appointment home preference is invalid.");
+  }
+  return {
+    version: "clinic-visit.v1", kind: value.kind as ClinicVisitState["kind"],
+    demographics: { ageYears: age, sexLabel: value.demographics.sexLabel },
+    ...(familyId ? { pediatricFamilyId: familyId } : {}),
+    ...(value.requestedRoomInstanceId !== undefined ? { requestedRoomInstanceId: value.requestedRoomInstanceId as string } : {}),
+  };
+}
