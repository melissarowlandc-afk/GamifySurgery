 function isRecord(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null;
+}
+
+function isSpecialtyId(value: unknown): value is string {
+  return typeof value === "string" && value.length > 0 && value.length <= 120;
+}
+
+function hasContractKeys(value: unknown, keys: readonly string[]): value is Record<string, unknown> {
+  return isRecord(value) && !Array.isArray(value) && Object.keys(value).every((key) => keys.includes(key));
+}
+
+function readPediatricFamilyId(value: unknown): string | undefined {
+  if (value === undefined) return undefined;
+  if (!isSpecialtyId(value)) throw new Error("The saved pediatric family ID is invalid.");
+  return value;
+}
