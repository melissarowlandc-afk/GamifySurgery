+/** Validate frozen links and aligned remaining travel without rerolling actors. */
+function validatePediatricFamilyLinks(state: GameState, context: DomainContext): void {
+  const families = state.pediatricFamilies ?? {};
+  const usedChildren = new Set<string>();
+  const usedParents = new Set<string>();
+  for (const family of Object.values(families)) {
+    const childKey = `${family.child.kind}:${family.child.id}`;
+    if (usedChildren.has(childKey) || usedParents.has(family.parentActorId)) throw new Error("The saved pediatric family duplicates a child or parent.");
+    usedChildren.add(childKey); usedParents.add(family.parentActorId);
+    if (family.phase === "departed") continue;
+    const parent = state.retailExternalActors.find((actor) => actor.id === family.parentActorId);
+    const encounter = family.child.kind === "encounter" ? state.encounters[family.child.id] : undefined;
+    const operation = family.child.kind === "service_visitor" ? state.serviceOperations.find((op) => op.id === family.child.id) : undefined;
+    if (!parent || parent.kind !== "companion" || parent.pediatricFamilyId !== family.id || parent.procedureCompanion || parent.activeRetailOperationId !== null ||
+        (encounter ? encounter.pediatricFamilyId !== family.id || !encounter.frozenCase.pediatricProfile || parent.linkedEncounterId !== encounter.id
+          : !operation || operation.clinicVisit?.kind !== "pediatric_consult" || operation.clinicVisit.pediatricFamilyId !== family.id || parent.linkedServiceOperationId !== operation.id)) {
+      throw new Error("The saved pediatric family has missing or incompatible actors.");
+    }
+    const childLocation = encounter?.patientLocation ?? operation?.location;
+    if (pediatricRoomAtPoint(state, context, childLocation)?.id !== pediatricRoomAtPoint(state, context, parent.location)?.id ||
+      Boolean(childLocation) !== Boolean(parent.location)) throw new Error("The saved pediatric child and parent must stay together.");
+    if (family.movement?.childPath.slice(family.movement.pathIndex).some((point, index) =>
+      pediatricRoomAtPoint(state, context, point)?.id !== pediatricRoomAtPoint(state, context, family.movement!.parentPath[family.movement!.pathIndex + index])?.id)) {
+      throw new Error("The saved pediatric travel must cross rooms together.");
+    }
+    if (family.reservation) {
+      const room = state.rooms.find((candidate) => candidate.id === family.reservation!.roomInstanceId);
+      const definition = room && getRoomDefinition(room.roomDefinitionId, context);
+      const width = room && (room.orientation === 90 || room.orientation === 270 ? definition?.height : definition?.width);
+      const height = room && (room.orientation === 90 || room.orientation === 270 ? definition?.width : definition?.height);
+      if (!room || !width || !height || [family.reservation.childLocation, family.reservation.parentLocation].some((point) =>
+        point.x + .5 < room.x || point.y + .5 < room.y || point.x + .5 >= room.x + width || point.y + .5 >= room.y + height)) {
+        throw new Error("The saved pediatric pair reservation must use one existing room.");
+      }
+    }
+  }
+  for (const encounter of Object.values(state.encounters)) {
+    if (encounter.pediatricFamilyId !== undefined && (families[encounter.pediatricFamilyId]?.child.kind !== "encounter" ||
+        families[encounter.pediatricFamilyId]?.child.id !== encounter.id)) throw new Error("The saved pediatric encounter has an orphan family link.");
+  }
+  for (const operation of state.serviceOperations) {
+    const familyId = operation.clinicVisit?.pediatricFamilyId;
+    if (familyId !== undefined && (families[familyId]?.child.kind !== "service_visitor" || families[familyId]?.child.id !== operation.id)) {
+      throw new Error("The saved pediatric visit has an orphan family link.");
+    }
+  }
+  for (const parent of state.retailExternalActors) {
+    if (parent.pediatricFamilyId !== undefined && families[parent.pediatricFamilyId]?.parentActorId !== parent.id) {
+      throw new Error("The saved pediatric parent has an orphan family link.");
+    }
+  }
