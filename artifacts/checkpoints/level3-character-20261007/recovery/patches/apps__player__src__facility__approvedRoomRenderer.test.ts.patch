+    const occupied = resolveApprovedRoomDrawRecords("room.ambulatory_or", 0, "occupiedCovered");
+    for (const records of [empty, occupied]) {
+      expect(getApprovedDrawPainterGround(records.find((draw) => draw.id === "table")!)).toBe(2.58);
