# Optional hosted Beta 1 auth. Copy to apps/player/.env.local (ignored).
# The owner pastes only the project URL and PUBLIC publishable/legacy anon key.
# Never put service_role, secret keys, SMTP passwords or DB credentials here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave empty for the existing unconfigured owner-local prototype entry.
# Set false for a configured invited build; missing configuration then blocks.
VITE_ENABLE_LOCAL_PROTOTYPE_BYPASS=
