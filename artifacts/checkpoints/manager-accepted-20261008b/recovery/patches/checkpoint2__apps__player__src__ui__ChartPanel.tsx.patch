+/** Short charts sit at the desk's top center; taller charts retain their bottom pin. */
+export function getChartPlacement({
+  desk,
+  area,
+  viewportHeight,
+  contentHeight,
+}: {
+  desk: Pick<DOMRect, "left" | "top" | "bottom" | "width" | "height">;
+  area: Pick<DOMRect, "left" | "top" | "right">;
+  viewportHeight: number;
+  contentHeight: number;
+}): CSSProperties {
+  const minLeft = area.left + CHART_EDGE_GAP;
+  const maxRight = area.right - CHART_EDGE_GAP;
+  const width = Math.min(CHART_PREFERRED_WIDTH, maxRight - minLeft);
+  const fitsDesk = contentHeight < desk.height;
+  const preferredLeft =
+    fitsDesk || desk.width >= width
+      ? desk.left + (desk.width - width) / 2
+      : desk.left;
+  const left = Math.max(minLeft, Math.min(preferredLeft, maxRight - width));
+  return {
+    left: Math.round(left),
+    width: Math.round(width),
+    top: fitsDesk ? Math.round(desk.top) : "auto",
+    bottom: fitsDesk ? "auto" : Math.round(Math.max(0, viewportHeight - desk.bottom)),
+    maxHeight: Math.round(Math.max(160, desk.bottom - area.top - CHART_EDGE_GAP)),
+  };
+}
