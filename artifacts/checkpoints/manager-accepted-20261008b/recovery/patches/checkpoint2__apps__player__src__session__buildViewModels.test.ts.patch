+describe("approved room upgrade ladders in player views", () => {
+  // Owner-approved table, checked through the actual player projection.
+  const rows: ReadonlyArray<readonly [string, string, string[], number[]]> = [
+    ["room.examination", "+2 satisfaction points after examination", ["+2 points", "+4 points", "+6 points", "+8 points"], [90, 140, 210, 300]],
+    ["room.waiting", "+2 satisfaction points for waiting patients", ["+2 points", "+4 points", "+6 points", "+8 points"], [110, 170, 250, 360]],
+    ["room.bathroom", "10% slower cleanliness loss", ["10% slower loss", "20% slower loss", "30% slower loss", "40% slower loss"], [70, 110, 170, 250]],
+    ["room.minor_procedure", "+6% procedure revenue", ["+6%", "+12%", "+18%", "+24%"], [220, 330, 480, 680]],
+    ["room.ultrasound", "+6% ultrasound service revenue", ["+6%", "+12%", "+18%", "+24%"], [240, 360, 525, 715]],
+    ["room.xray", "+6% X-ray service revenue", ["+6%", "+12%", "+18%", "+24%"], [190, 280, 400, 560]],
+    ["room.ct", "+6% CT/CTA revenue", ["+6%", "+12%", "+18%", "+24%"], [400, 600, 880, 1200]],
+    ["room.phlebotomy", "+6% specimen-collection revenue", ["+6%", "+12%", "+18%", "+24%"], [140, 210, 305, 415]],
+    ["room.evs_closet", "Cleaning takes 10% less time", ["10% less time", "20% less time", "30% less time", "40% less time"], [120, 180, 260, 360]],
+    ["room.endoscopy", "+6% endoscopy revenue", ["+6%", "+12%", "+18%", "+24%"], [365, 545, 800, 1090]],
+    ["room.periop_recovery", "+2 satisfaction points after recovery", ["+2 points", "+4 points", "+6 points", "+8 points"], [225, 340, 495, 675]],
+    ["room.training", "Training sessions take 10% less time", ["10% less time", "20% less time", "30% less time", "40% less time"], [165, 245, 360, 490]],
+    ["room.coffee_kiosk", "+1 staff morale point from daily coffee", ["+1 point", "+2 points", "+3 points", "+4 points"], [125, 190, 275, 375]],
+    ["room.glp1_telehealth_suite", "+6% telehealth revenue", ["+6%", "+12%", "+18%", "+24%"], [300, 450, 660, 900]],
+    ["room.ambulatory_or", "+6% operation revenue", ["+6%", "+12%", "+18%", "+24%"], [600, 900, 1320, 1800]],
+    ["room.laboratory", "+6% paid laboratory-processing revenue", ["+6%", "+12%", "+18%", "+24%"], [450, 675, 990, 1350]],
+    ["room.pharmacy", "+6% pharmacy sales revenue", ["+6%", "+12%", "+18%", "+24%"], [300, 450, 660, 900]],
+    ["room.maintenance_workshop", "Repairs take 10% less time", ["10% less time", "20% less time", "30% less time", "40% less time"], [200, 300, 440, 600]],
+    ["room.staff_break", "+2 staff morale points per break", ["+2 points", "+4 points", "+6 points", "+8 points"], [225, 340, 495, 675]],
+    ["room.surgeon_office", "Quality reviews take 10% less time", ["10% less time", "20% less time", "30% less time", "40% less time"], [175, 265, 385, 525]],
+    ["room.vending", "+6% vending revenue", ["+6%", "+12%", "+18%", "+24%"], [115, 170, 250, 340]],
+    ["room.reading", "Scan reading takes 10% less time", ["10% less time", "20% less time", "30% less time", "40% less time"], [450, 675, 990, 1350]],
+  ];
+
+  it.each(rows)("shows the complete playable ladder for %s", (roomDefinitionId, perUpgradeLabel, totals, prices) => {
+    const state = createInitialGameState(); state.facilityLevel = 3; state.cash = 100_000; state.cashCents = 10_000_000;
+    state.encounters = {};
+    const room = { id: "room.upgrade.view", roomDefinitionId, x: 20, y: 12,
+      orientation: 0 as const, doorSide: null, upgradeLevel: 1 as RoomUpgradeLevel, cleanliness: 100 };
+    state.rooms.push(room);
+    for (const level of [1, 2, 3, 4, 5] as const) {
+      room.upgradeLevel = level;
+      const view = createPrototypePlayerView(state, null, false, null, true, room.id);
+      const selected = view.selectedRoomBuild!;
+      const owned = view.ownedRooms.find((candidate) => candidate.id === room.id)!;
+      const expected = { perUpgradeLabel, currentLabel: level === 1 ? "Baseline" : totals[level - 2] };
+      expect(selected.benefit).toMatchObject(expected);
+      expect(owned.benefit).toEqual(selected.benefit);
+      expect(owned.benefitSummary).toBe(perUpgradeLabel);
+      expect(selected.maxUpgradeLevel).toBe(5);
+      expect(view.facility.rooms.find((candidate) => candidate.instanceId === room.id)?.upgradeMaxLevel).toBe(5);
+      if (level < 5) {
+        expect(selected.benefit?.nextLabel).toBe(totals[level - 1]);
+        const price = `$${prices[level - 1]!.toLocaleString()}`;
+        expect(selected.upgradeCostLabel).toBe(price);
+        expect(owned.nextUpgradeCostLabel).toBe(price);
+        expect(selected.nextUpgradeLevel).toBe(level + 1);
+        expect(selected.canUpgrade).toBe(true);
+        expect(selected.upgradeImprovements).toContain(perUpgradeLabel);
+      } else {
+        expect(selected.benefit?.nextLabel).toBeUndefined();
+        expect(selected.upgradeCostLabel).toBeUndefined();
+        expect(owned.nextUpgradeCostLabel).toBeUndefined();
+        expect(selected.canUpgrade).toBe(false);
+        expect(selected.upgradeImprovements).toEqual([]);
+      }
+      expect(JSON.stringify(selected.benefit)).not.toMatch(/Clinic total|shared|capped|capacity|fixture|finish/);
+    }
+  });
+
+  it("shows each room copy's totals and retains Examination capacity and admitted patients", () => {
+    let state = createInitialGameState(); state.facilityLevel = 3; state.cash = 10_000; state.cashCents = 1_000_000;
+    const front = state.rooms.find((room) => room.roomDefinitionId === "room.front_desk")!;
+    const caseId = state.encounters[TUTORIAL_ENCOUNTER_ID]!.frozenCase.id;
+    const placed = { id: "room.upgrade.exam", roomDefinitionId: "room.examination", x: front.x, y: front.y - 2,
+      orientation: 0 as const, doorSide: null, upgradeLevel: 1 as RoomUpgradeLevel, cleanliness: 100 };
+    state.rooms.push(placed);
+    state.doors.push({ id: "door.upgrade.exam", roomId: placed.id, side: "south", offset: 1, exterior: false });
+    state.encounters = {};
+    state = gameReducer(state, { type: "ADMIT_PATIENT", operationId: "upgrade-view.admit",
+      encounterId: "encounter.upgrade-view.admitted", caseId, patientDisplayName: "Upgrade Test Patient", arrivalClass: "routine" });
+    expect(state.operationReceipts["upgrade-view.admit"]).toMatchObject({ status: "applied" });
+    expect(Object.keys(state.encounters)).toEqual(["encounter.upgrade-view.admitted"]);
+    const exam = state.rooms.find((room) => room.id === placed.id)!;
+    const beforeCapacity = getWorkloadSnapshot(state).routineLimit;
+    const beforeEncounters = structuredClone(state.encounters);
+    state.rooms.push({ ...exam, id: "room.upgrade.exam-copy", x: 25, y: 12, upgradeLevel: 1 });
+    exam.upgradeLevel = 5;
+    const view = createPrototypePlayerView(state, null, false, null, true, exam.id);
+    expect(view.ownedRooms.find((room) => room.id === exam.id)?.benefit?.currentLabel).toBe("+8 points");
+    expect(view.ownedRooms.find((room) => room.id === "room.upgrade.exam-copy")?.benefit).toMatchObject({ currentLabel: "Baseline", nextLabel: "+2 points" });
+    state.rooms.pop();
+    expect(getWorkloadSnapshot(state).routineLimit).toBe(beforeCapacity);
+    expect(state.encounters).toEqual(beforeEncounters);
+  });
+
+  it.each(["room.front_desk", "room.hallway", "room.imaging_control"])("shows no purchase or stars for %s", (roomDefinitionId) => {
+    const state = createInitialGameState();
+    const room = { id: "room.upgrade.non-purchase", roomDefinitionId, x: 20, y: 12,
+      orientation: 0 as const, doorSide: null, upgradeLevel: 3 as const, cleanliness: 100 };
+    state.rooms.push(room);
+    const view = createPrototypePlayerView(state, null, false, null, true, room.id);
+    expect(view.selectedRoomBuild).toMatchObject({ upgradeable: false, maxUpgradeLevel: 1, canUpgrade: false });
+    expect(view.selectedRoomBuild?.benefit).toBeUndefined();
+    expect(view.selectedRoomBuild?.upgradeCostLabel).toBeUndefined();
+    expect(view.facility.rooms.find((candidate) => candidate.instanceId === room.id)?.upgradeMaxLevel ?? 1).toBe(1);
+  });
+});
