+/** Independent density audit: only the audit bins points, never the renderer. */
+function axisDensityCorrelations(points: readonly { x: number; y: number }[], columns: number, rows: number) {
+  const width = columns * 2, height = rows * 2;
+  const bins = Array.from({ length: height }, () => new Float64Array(width));
+  for (const point of points) {
+    const x = Math.floor(point.x * 2), y = Math.floor(point.y * 2);
+    if (x >= 0 && x < width && y >= 0 && y < height) bins[y]![x]! += 1;
+  }
+  const correlations: number[] = [];
+  for (const axis of ["x", "y"]) for (let shift = 6; shift <= 32; shift += 1) {
+    const dx = axis === "x" ? shift : 0, dy = axis === "y" ? shift : 0;
+    let sumA = 0, sumB = 0, sumAA = 0, sumBB = 0, sumAB = 0, count = 0;
+    for (let y = 0; y < height - dy; y += 1) for (let x = 0; x < width - dx; x += 1) {
+      const a = bins[y]![x]!, b = bins[y + dy]![x + dx]!;
+      sumA += a; sumB += b; sumAA += a * a; sumBB += b * b; sumAB += a * b; count += 1;
+    }
+    const denominator = Math.sqrt((sumAA - sumA * sumA / count) * (sumBB - sumB * sumB / count));
+    correlations.push(denominator ? (sumAB - sumA * sumB / count) / denominator : 0);
+  }
+  return correlations;
+}
