+        expect(top).toBeGreaterThanOrEqual(0);
+        expect(left + primitive.width).toBeLessThanOrEqual(width * room.shell.tilePixels);
+        expect(top + primitive.height).toBeLessThanOrEqual(height * room.shell.tilePixels);
+      }
