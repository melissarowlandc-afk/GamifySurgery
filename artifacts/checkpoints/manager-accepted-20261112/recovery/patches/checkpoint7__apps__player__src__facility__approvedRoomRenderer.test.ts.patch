+  it("clips concrete/vending floor blooms to the footprint without moving their in-room outline", () => {
+    const crossing = { shape: "ellipse" as const, x: 0, y: 0, width: 20, height: 20, color: "#ffffff", alpha: .13 };
+    const [clipped] = clipApprovedFloorEllipses([crossing], 20, 20);
+    expect(clipped).toMatchObject({ shape: "polygon", x: 0, y: 0, width: 10, height: 10, color: "#ffffff", alpha: .13 });
+    expect(clipped!.points!.every(point => point.x >= 0 && point.y >= 0 && point.x <= 20 && point.y <= 20)).toBe(true);
+    const retainedArc = clipped!.points!.filter(point => point.x > 0 && point.y > 0);
+    expect(retainedArc.length).toBeGreaterThan(3);
+    for (const point of retainedArc) expect(Math.hypot(point.x, point.y)).toBeCloseTo(10, 10);
+    const contained = { ...crossing, x: 10, y: 10, width: 10, height: 10 };
+    expect(clipApprovedFloorEllipses([contained], 20, 20)[0]).toBe(contained);
+    expect(clipApprovedFloorEllipses([{ ...crossing, x: -250, y: -203, width: 330, height: 330 }], 360, 360)).toEqual([]);
+    expect(crossing).toEqual({ shape: "ellipse", x: 0, y: 0, width: 20, height: 20, color: "#ffffff", alpha: .13 });
+    for (const id of ["room.maintenance_workshop", "room.vending"]) {
