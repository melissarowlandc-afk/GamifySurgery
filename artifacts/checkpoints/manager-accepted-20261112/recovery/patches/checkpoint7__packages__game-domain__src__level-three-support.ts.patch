+/** One clinic-wide daily benefit: the best reachable operational staff room,
+ * not the sum of rooms. Busy staff benefit without leaving a care assignment. */
+export function getBestOperationalStaffRoomMoraleBonus(state: GameState, context: DomainContext): number {
+  if (state.facilityLevel < 3) return 0;
+  const tuning = context.balanceRelease.environment.levelThreeSupport;
+  return state.rooms.reduce((best, room) => {
+    if (!(room.roomDefinitionId === "room.staff_break" || state.facilityLevel >= 5 && room.roomDefinitionId === "room.staff_gym") ||
+        !isRoomOperationalForFacilityWork(state, room.id, context)) return best;
+    return Math.max(best, tuning.staffRoomMoraleBonusPerDay +
+      getRoomUpgradePurchaseCount(room.upgradeLevel) * tuning.staffRoomMoraleBonusPerUpgrade);
+  }, 0);
+}
