--- a/apps/player/src/mobile/manage/mobileManage.css
+++ b/apps/player/src/mobile/manage/mobileManage.css
@@ -2,7 +2,7 @@
 .mobile-shell .mobile-manage { min-width: 0; width: 100%; font-size: 15px; line-height: 1.45; }
 .mobile-shell .mobile-manage-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
 .mobile-shell .mobile-manage-heading > span { padding: 6px 10px; background: var(--panel); border-radius: 8px; font-weight: 700; }
-.mobile-shell .mobile-manage-segments { position: sticky; top: -10px; z-index: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; margin-bottom: 12px; padding: 4px; background: var(--panel); border: var(--mobile-border); border-radius: 12px; }
+.mobile-shell .mobile-manage-segments { position: sticky; top: -10px; z-index: 1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; margin-bottom: 12px; padding: 4px; background: var(--panel); border: var(--mobile-border); border-radius: 12px; }
 .mobile-shell .mobile-manage-segments button { min-height: 48px !important; padding: 8px 3px; border: 0; background: transparent; font-size: 15px; }
 .mobile-shell .mobile-manage-segments button[aria-selected="true"] { background: var(--paper-raised); box-shadow: 0 1px 4px #0003; font-weight: 700; }
 .mobile-shell .mobile-manage-stack { display: grid; gap: 8px; min-width: 0; }
