ototype.v1","salaryEconomyVersion":"room-economy-b.v1","schedulerPins":{"integrationVersion":"fsrs-adapter.v1","libraryName":"ts-fsrs","libraryVersion":"5.4.1","algorithmVersion":"FSRS-6","parameterSetId":"learning.prototype.fsrs6.v1"},"facilityLevel":5,"facilityTick":21424,"paused":true,"simulationSpeed":1,"cash":56562.13,"cashCents":5656213,"operatingAccrualSixtiethCents":97868,"nextFinancialPostingTick":21435,"advertisingLevel":0,"clinicalXp":3410,"openChartEncounterId":null,"attendedEncounterId":null,"employeeDiscussions":{"discussion.employee.0":{"id":"discussion.employee.0","clinicalReleaseId":"clinical.synthetic.prototype.v1","frozenCase":{"id":"case.gs028se.independent-t-paired-t.a-two-cohorts","displayName":"Select an independent-samples t test and Select a paired t test","patientPresentationVariantId":"presentation.gs028se.independent-t-paired-t.a-two-cohorts","releasePointId":"release.l0.clinic_evaluation","patientDisplayName":"Marley","participant":{"kind":"employee_discussion","requiredStaffRoleDefinitionIds":["staff.glp1_np","staff.endoscopy_nurse","staff.endoscopist","staff.periop_nurse","staff.surgeon","staff.or_nurse","staff.pharmacist","staff.radiologist"]},"chiefComplaint":"lactational breast abscess study","presentation":"Marley, the breast-service research lead, reviews a trial of a new topical agent after drainage of lactational breast abscesses. Different participants received each preparation. Ultrasound measured the remaining cavity area at the protocol visit. A colleague proposes linking the groups because the same sonographer collected all measurements. The report includes the distribution checks for analysis.","tutorialEligible":false,"routineEligible":true,"earliestFacilityStage":2,"requiredClinicalSetting":"clinic","requiredCapabilityIds":[],"rewardTierId":"reward.clinic_basic","sourceLabels":["Two-Sample t-Test","Paired t-Test","McNemar Test","ACR Appropriateness Criteria Breast Imaging During Lactation","Academy of Breastfeeding Medic