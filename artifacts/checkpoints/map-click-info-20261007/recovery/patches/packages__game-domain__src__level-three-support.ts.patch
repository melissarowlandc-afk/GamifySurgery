+const FOUNDER_BREAK_SEAT_PREFIX = "break-seat:";
+
+/** Founder `sit_in_chair` target for a Break Room seat; the seat id rides in the saved targetId. */
+export function formatFounderBreakSeatTargetId(roomId: string, seatId: LevelThreeBreakSeatId): string {
+  return `${FOUNDER_BREAK_SEAT_PREFIX}${roomId}:${seatId}`;
+}
+
+/** The Break Room seat the founder is walking to or sitting in, if any. */
+export function getFounderBreakSeatClaim(state: GameState): { roomId: string; seatId: LevelThreeBreakSeatId } | null {
+  const activity = state.environment.founderActivity;
+  if (activity?.kind !== "sit_in_chair" || !activity.targetId.startsWith(FOUNDER_BREAK_SEAT_PREFIX)) return null;
+  const body = activity.targetId.slice(FOUNDER_BREAK_SEAT_PREFIX.length);
+  const split = body.lastIndexOf(":");
+  const seatId = body.slice(split + 1);
+  const seat = LEVEL_THREE_BREAK_SEATS.find((candidate) => candidate.id === seatId);
+  return split > 0 && seat ? { roomId: body.slice(0, split), seatId: seat.id } : null;
+}
+
+export function getLevelThreeBreakSeatTarget(state: GameState, room: PlacedRoom, seatId: LevelThreeBreakSeatId, context: DomainContext): GridPoint | null {
+  return targetForBreakSeat(state, room, seatId, context);
+}
