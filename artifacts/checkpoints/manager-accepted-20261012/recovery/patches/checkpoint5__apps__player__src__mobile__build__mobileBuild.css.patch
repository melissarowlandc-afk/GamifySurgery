--- a/apps/player/src/mobile/build/mobileBuild.css
+++ b/apps/player/src/mobile/build/mobileBuild.css
@@ -14,6 +14,14 @@
 .mobile-shell .mobile-build-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 8px 0 12px; }
 .mobile-shell .mobile-build-tabs button[aria-selected="true"] { background: var(--focus); font-weight: 700; }
 .mobile-shell .mobile-build-cards { display: grid; gap: 12px; }
+.mobile-shell .mobile-prestige-build-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
+.mobile-shell .mobile-prestige-build-tile { min-width: 0; min-height: 44px; display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 8px; border: var(--mobile-border); border-radius: 10px; background: var(--paper); text-align: center; overflow-wrap: anywhere; }
+.mobile-shell .mobile-prestige-build-tile .mobile-room-thumbnail { width: 57px; height: auto; }
+.mobile-shell .mobile-prestige-build-tile strong { font-size: 14px; line-height: 1.15; }
+.mobile-shell .mobile-prestige-build-tile span, .mobile-shell .mobile-prestige-build-tile small { font-size: 12px; line-height: 1.2; }
+.mobile-shell .mobile-earlier-build-rooms > summary { min-height: 44px; padding: 12px; border: var(--mobile-border); border-radius: 8px; background: var(--paper); cursor: pointer; }
+.mobile-shell .mobile-earlier-build-rooms[open] > summary { margin-bottom: 8px; }
+@media (min-width: 700px) { .mobile-shell .mobile-prestige-build-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
 .mobile-shell .mobile-build-card { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 10px; padding: 10px; background: var(--paper); border: var(--mobile-border); border-radius: 10px; }
 .mobile-shell .mobile-build-card h3 { font-size: 17px; margin: 0 0 4px; }
 .mobile-shell .mobile-build-card p { font-size: 13px; line-height: 1.4; margin: 4px 0; }
