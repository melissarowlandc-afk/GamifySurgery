+    expect(restored.rooms.some((room) => room.id === "legacy.control")).toBe(true);
+    expect(restored.encounters.pending?.pendingResult).toMatchObject({
+      routeId: "route.ultrasound.in_house", imagingTechnicianId: null, dueTick: 75,
+    });
+  });
+});
